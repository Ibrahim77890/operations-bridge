OPSBRIDGE_VERSION=0.2.0
OPSBRIDGE_HOST=127.0.0.1
OPSBRIDGE_PORT=8080
OPSBRIDGE_RUNTIME_DIR=/tmp/opsbridge
OPSBRIDGE_MAX_BODY_SIZE=8192
OPSBRIDGE_MAX_OUTPUT_SIZE=65536
OPSBRIDGE_MAX_HEADER_LENGTH=4096
OPSBRIDGE_MAX_REQUEST_LINE_LENGTH=2048
OPSBRIDGE_MAX_COMMAND_LENGTH=32
OPSBRIDGE_MAX_TARGET_LENGTH=32
OPSBRIDGE_MAX_PARAMETER_KEY_LENGTH=64
OPSBRIDGE_MAX_PARAMETER_VALUE_LENGTH=256
OPSBRIDGE_RATE_LIMIT_PER_MINUTE=60
OPSBRIDGE_REPLAY_TTL_SECONDS=900
